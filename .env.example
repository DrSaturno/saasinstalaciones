# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública exacta de la aplicación
APP_URL=http://localhost:3000

# Invitaciones por email (opcionales)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Push (opcional en el frontend)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Calendar (opcional; necesario para conectar y sincronizar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes en base64. Ejemplo de generación: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Rate limiting distribuido (SEC-08 de la auditoría de seguridad).
# Sin credenciales de Redis el límite degrada a no-op (dev/CI andan igual). Con
# ellas se activa en login, recuperación de contraseña, export de locaciones y
# verificación de MFA.
#
# Se aceptan DOS convenciones de nombres y alcanza con UNA:
#
#  a) UPSTASH_* — Upstash directo. Es la de desarrollo local: se crea una base
#     Redis en https://upstash.com (tiene free tier) y se copian de "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
#  b) KV_REST_API_* — las que inyecta SOLA la integración de Upstash en Vercel.
#     Son las que usa PRODUCCIÓN. No hace falta cargarlas a mano: aparecen al
#     conectar la base desde Vercel → Storage. Se listan acá sólo para que se
#     sepa que existen y de dónde salen.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Provistas automáticamente por Vercel — NO cargar a mano.
# VERCEL_DEPLOYMENT_ID          Identifica el build; mitiga el desfasaje de
#                               versiones (skew) al navegar con pestañas viejas.
# VERCEL_PROJECT_PRODUCTION_URL URL canónica de producción.

# ---------------------------------------------------------------------------
# NO van acá: los secretos de la Edge Function `send-event-push` viven en el
# almacén de secretos de Supabase, no en Next:
#   VAPID_PUBLIC_KEY · VAPID_PRIVATE_KEY · VAPID_SUBJECT
# La clave privada VAPID en Vercel sería una fuga.
# ---------------------------------------------------------------------------
